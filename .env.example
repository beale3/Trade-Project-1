# HELM (trade) — environment template. COPY to `.env` (gitignored) and fill locally.
# NEVER commit `.env`; NEVER paste the SECRET values below into chat or any tracked file.
# The Director/SecOps installs the secret values directly; the agent must not handle them (B5).

# --- Supabase project (ref: zyscsnhiymitpfdhjuci) ---
# SAFE-ish (publishable — designed for client exposure, but still keep out of git):
SUPABASE_URL=https://zyscsnhiymitpfdhjuci.supabase.co
SUPABASE_ANON_KEY=            # publishable/anon key (RLS-enforced) — from Supabase → Project Settings → API

# SECRET — full access, bypasses RLS / DB superuser. Server-only. Never in chat, never committed:
SUPABASE_SERVICE_ROLE_KEY=   # service_role key — Project Settings → API
DATABASE_URL=                # postgresql://postgres:[PASSWORD]@db.zyscsnhiymitpfdhjuci.supabase.co:5432/postgres
                             # (or the pooler URL from Project Settings → Database → Connection string)

# --- Supabase MCP connector (.mcp.json reads this from the ENVIRONMENT) ---
# SECRET — a Supabase Personal Access Token (Account → Access Tokens). NOT the anon/service_role keys.
# Must be set as an ENV VAR before launching Claude Code (see docs/infra/supabase.md), not just here.
SUPABASE_ACCESS_TOKEN=       # e.g. sbp_...  — powers the read-only Supabase MCP server
